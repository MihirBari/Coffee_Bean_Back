PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=coffee_bean_db
CLIENT_URL=http://localhost:5173
JWT_SECRET=coffee_bean_artisan_secret_key_2026

# Cloudinary Image Storage Configuration
# Get these from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SMTP Mail Server Configuration (Nodemailer)
# Real emails sent when order is Processing, Shipped, or Delivered.
# If left blank, simulated emails are cleanly logged to the console and database.
# For Gmail: Enable 2-Step Verification -> Create App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="The Bean Co. Roastery" <info@thebean.company>

# SMS Gateway Configuration
# Real SMS notifications sent to customers when order is Processing, Shipped, or Delivered.
# If left blank, simulated SMS messages are cleanly logged to the server console and database.
# Option A: Twilio (Global) - https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Option B: Fast2SMS (India) - https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=

# Razorpay Payment Gateway Configuration (India)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
